# The COCO dataset, at the repo root ONLY. Anchored with a leading slash:
# a bare "data/" matches every nested data/ directory at any depth, which
# silently swallowed a 356-file evidence folder on Sep 12. Keep the slash.
/data/
*.pth
*.onnx
__pycache__/
*.py[cod]
logs/
training/
*.log
*_watch.log
export/tmp_stage.txt
export/hybrid_follow/*.txt
export/hybrid_follow/*.json
export/hybrid_follow/weights_txt/
visibility_diagnostic*.csv
